# Configuracion por defecto del Nodo 1 (ESP32-C6 + OpenThread).
# Se aplica al ejecutar: idf.py set-target esp32c6 && idf.py build

# Objetivo
CONFIG_IDF_TARGET="esp32c6"

# OpenThread como Full Thread Device (actua como Router)
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_FTD=y
CONFIG_OPENTHREAD_CLI=n
CONFIG_OPENTHREAD_RADIO_NATIVE=y

# Canal 25 por defecto (la central puede recomisionar via Bring-up)
CONFIG_OPENTHREAD_NETWORK_CHANNEL=25

# Radio IEEE 802.15.4 nativa del ESP32-C6
CONFIG_IEEE802154_ENABLED=y

# eventfd requerido por el driver OpenThread
CONFIG_VFS_SUPPORT_IO=y

# IPv6 en lwIP (requerido por Thread / 6LoWPAN)
CONFIG_LWIP_IPV6=y

# Log por defecto en nivel INFO
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Holgura de stack para la tarea principal
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
